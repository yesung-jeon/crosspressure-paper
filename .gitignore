# keys stay in a local .env (never committed)
.env
__pycache__/
*.pyc
.Rhistory
.venv/

# raw data are downloaded by replication/data/fetch_data.py, not redistributed
replication/data/*
!replication/data/fetch_data.py

# run records of a local pipeline run
replication/logs/

# regenerated by every paper build (replication/paper/build.py)
replication/paper/_gate/
replication/paper/sections/*.md
!replication/paper/sections/*.template.md
replication/paper/figures/FIGURES_SHA256.json
replication/paper/used_keys.json

# regenerated by every run of the pipeline; not sealed (tools/validate.py NOT_SHIPPED, tools/clear_outputs.py)
replication/12_speech_and_state/out/s0/
*.rds
*_input.csv.gz

# R session records (written by every R run; contain local paths)
**/logs/session_info.txt
